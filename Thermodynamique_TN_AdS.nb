(* Fig 10 : S(T) avec gap entropique \[CapitalDelta]S = \[Pi](r2^2 - r1^2) aux points de coexistence. *)
pratiosST = {0.5, 0.8, 1.0, 1.3};
stylesST = Table[If[pratiosST[[i]] == 1.0,
                    {colorF[i], Thick, Dashing[{0.02, 0.01}]},
                    {colorF[i], Thick}],
                 {i, Length[pratiosST]}];

gapEpilog = Flatten[
  Table[
    Module[{prCoex, Pexact, idxC, Tco, Pco, r1c, r2c, r1g, r2g, solExact,
            S1c, S2c, dSc, col, yAxesFrac, Smid, yInset, xLim = 0.08, yLim = 200},
      prCoex = {0.5, 0.8}[[iGap]];
      Pexact = prCoex * PcN;
      idxC = First[Ordering[Abs[Pcoex - Pexact]]];
      r1g = coexData[[idxC, 3]]; r2g = coexData[[idxC, 4]];
      solExact = Quiet[FindRoot[
        {TRN[r1, Pexact] == TRN[r2, Pexact],
         GRN[r1, Pexact] == GRN[r2, Pexact]},
        {{r1, r1g}, {r2, r2g}},
        MaxIterations -> 300, AccuracyGoal -> 12, WorkingPrecision -> MachinePrecision]];
      r1c = r1 /. solExact; r2c = r2 /. solExact;
      Tco = TRN[r1c, Pexact]; Pco = Pexact;
      S1c = Pi r1c^2; S2c = Pi r2c^2; dSc = S2c - S1c;
      col = colorF[iGap];
      Smid = (S1c + S2c)/2;
      yAxesFrac = 0.97 - (iGap - 1) * 0.18;
      yInset = yAxesFrac * yLim;
      {
        {col, Thickness[0.004],
         Arrowheads[{-0.022, 0.022}],
         Arrow[{{Tco, S1c}, {Tco, S2c}}]},
        {col, Thickness[0.0015], Arrowheads[0.02],
         Arrow[{{0.97 xLim, yInset}, {Tco, Smid}}]},
        Inset[
          Framed[
            Style["\[CapitalDelta]S = \[Pi](r\!\(\*SubsuperscriptBox[\(2\), \(\), \(2\)]\)" <>
                  " - r\!\(\*SubsuperscriptBox[\(1\), \(\), \(2\)]\)) = " <>
                  ToString[NumberForm[dSc, {4, 1}]] <>
                  "  (P/P\!\(\*SubscriptBox[\(c\), \(\)]\) = " <>
                  ToString[prCoex] <> ")",
                  8, col],
            Background -> White, FrameStyle -> col,
            RoundingRadius -> 3],
          {0.97 xLim, yInset}, {Right, Center}]
      }
    ],
    {iGap, 1, 2}
  ], 2
];

(* Fig 10 : S(T) trace DIRECTEMENT via Plot sur les branches physiques *)
(* Memes branches que pour G(T) : k=1 PTN, k=2 instable, k=3 GTN          *)
(* Raccord de la branche GTN au-dessus de T_max : k=1 par unicite         *)

g10curves = Flatten[Table[
  Module[{Pv = pratiosST[[i]] * PcN, divs, sty, rMax = 12.0},
    divs = findCPdivs[Pv];
    sty = stylesST[[i]];
    If[Length[divs] == 2,
      {
        (* 1. PTN : de r+ -> Q jusqu'au premier point spinodal *)
        ParametricPlot[{TRN[rp, Pv], SRN[rp]}, {rp, QQ + 0.001, divs[[1]]},
          PlotStyle -> sty, PlotPoints -> 100, WorkingPrecision -> MachinePrecision],
          
        (* 2. Branche instable : entre les deux divergences de Cp *)
        ParametricPlot[{TRN[rp, Pv], SRN[rp]}, {rp, divs[[1]], divs[[2]]},
          PlotStyle -> {sty[[1]], Thin, Dashed, Opacity[0.6]}, PlotPoints -> 100, 
          WorkingPrecision -> MachinePrecision],
          
        (* 3. GTN : du second point spinodal jusqu'\[AGrave] rMax *)
        ParametricPlot[{TRN[rp, Pv], SRN[rp]}, {rp, divs[[2]], rMax},
          PlotStyle -> sty, PlotPoints -> 100, WorkingPrecision -> MachinePrecision]
      },
      (* Phase supercritique (P >= Pc) : branche unique sans divergence *)
      ParametricPlot[{TRN[rp, Pv], SRN[rp]}, {rp, QQ + 0.001, rMax},
        PlotStyle -> sty, PlotPoints -> 150, WorkingPrecision -> MachinePrecision]
    ]
  ],
  {i, Length[pratiosST]}
]];

g10 = Legended[
  Show[g10curves,
    Frame -> True,
    FrameLabel -> {Style["T", 16], Style["S", 16]},
    PlotRange -> {{0, 0.08}, {0, 200}},
    AspectRatio -> 1/GoldenRatio,
    PlotLabel -> Style["S(T) \[LongDash] Reissner-Nordstr\[ODoubleDot]m-AdS (Q = 1, trace direct)", 13, Bold],
    Epilog -> gapEpilog,
    GridLines -> Automatic,
    GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
    ImageSize -> 500,
    Background -> White
  ],
  Placed[
    LineLegend[Table[Directive[colorF[i], Thick], {i, Length[pratiosST]}],
      Table[Style["P/P\!\(\*SubscriptBox[\(c\), \(\)]\) = " <> ToString[pratiosST[[i]]], 10],
            {i, Length[pratiosST]}]],
    {Left, Top}]
];
saveFig[g10, "fig10_ST_rn"];

