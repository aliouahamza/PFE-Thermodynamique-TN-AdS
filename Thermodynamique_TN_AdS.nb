(* ::Package:: *)

(* ::Title:: *)
(*Thermodynamique des Trous Noirs Anti-de Sitter*)


(* ::Subtitle:: *)
(*Etude thermodynamique compl\[EGrave]te \[Dash] Calcul symbolique + Figures *)
(*Stage S4 \[Dash] LPHEAG, Universit\[EAcute] Cadi Ayyad, Marrakech*)
(*Auteur : Hamza Alioua \[Dash] Encadrant : Dr. S. Iraoui \[Dash] Avril 2026*)


(* ::Section::Closed:: *)
(*0. Initialisation*)


ClearAll["Global`*"];
$Assumptions = {r > 0, rp > 0, M > 0, P > 0, Q > 0, l > 0,
                T > 0, \[CapitalLambda] < 0};

outDir = FileNameJoin[{NotebookDirectory[], "figures"}];
If[!DirectoryQ[outDir], CreateDirectory[outDir]];

SetOptions[Plot,
  Frame -> True, FrameStyle -> Directive[Black, 14],
  LabelStyle -> Directive[FontFamily -> "Times New Roman", 14],
  GridLines -> Automatic,
  GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
  PlotStyle -> Thick,
  ImageSize -> 500,
  Background -> White
];
SetOptions[ParametricPlot,
  Frame -> True, FrameStyle -> Directive[Black, 14],
  LabelStyle -> Directive[FontFamily -> "Times New Roman", 14],
  GridLines -> Automatic,
  GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
  PlotStyle -> Thick,
  ImageSize -> 500,
  Background -> White
];

col = {"#2166AC", "#D6604D", "#4DAF4A", "#FF7F00", "#984EA3",
       "#A65628", "#E41A1C", "#377EB8"};
colorF[i_] := RGBColor @@ (IntegerDigits[
  FromDigits[StringTake[col[[i]], {2, -1}], 16], 256, 3]/255.);
saveFig[gr_, name_] := Module[{nbDir, path, path2, ok1, ok2},
  If[! (StringQ[outDir] && DirectoryQ[outDir]),
    nbDir = Quiet[NotebookDirectory[]];
    outDir = FileNameJoin[{If[StringQ[nbDir], nbDir, Directory[]], "figures"}];
    If[! DirectoryQ[outDir], CreateDirectory[outDir]]
  ];
  path  = FileNameJoin[{outDir, name <> ".pdf"}];
  path2 = FileNameJoin[{outDir, name <> ".png"}];
  ok1 = Quiet @ Check[Export[path,  gr, "PDF", ImageResolution -> 300], $Failed];
  ok2 = Quiet @ Check[Export[path2, gr, "PNG", ImageResolution -> 300], $Failed];
  If[ok1 === $Failed || ok2 === $Failed,
    Print["  [ECHEC] " <> name <> " : Export impossible (graphique invalide ou dossier inaccessible)"],
    Print["  [OK] " <> name <> ".pdf + .png"]
  ];
  gr   
];

Print["=== Initialisation compl\[EGrave]te ==="];
Print["Dossier de sortie : ", outDir];


(* ::Section::Closed:: *)
(*Partie 0 : Schwarzschild classique (\[CapitalLambda] = 0)*)


Print["\n", StringRepeat["=", 60]];
Print["PARTIE 0 : Schwarzschild classique (\[CapitalLambda] = 0)"];
Print[StringRepeat["=", 60]];


(* ::Subsection::Closed:: *)
(*D\[EAcute]rivation symbolique*)


(* Metrique : f(r) = 1 - 2M/r *)
fSchw[r_, Mv_] := 1 - 2 Mv/r;

(* Horizon : f(r+) = 0 donne M = rp/2 *)
solM0 = Solve[fSchw[rp, M] == 0, M][[1]];
M0sym = M /. solM0
Print["Masse ADM : M = ", M0sym];

(* Temperature de Hawking : T = f'(r+)/(4 Pi) *)
fPrime0 = D[fSchw[r, M0sym], r] /. r -> rp // Simplify;
T0sym = fPrime0 / (4 Pi) // Simplify
Print["Temp\[EAcute]rature de Hawking : T = ", T0sym];

S0sym = Pi rp^2;
Print["Entropie : S = ", S0sym];

dTdr0 = D[T0sym, rp];
C0sym = T0sym * (D[S0sym, rp] / dTdr0) // Simplify
Print["Capacit\[EAcute] calorique : C = ", C0sym];
Print["V\[EAcute]rification C < 0 : ", Simplify[C0sym < 0, rp > 0]];

G0sym = M0sym - T0sym * S0sym // Simplify
Print["Energie libre de Gibbs : G = ", G0sym];
Print["V\[EAcute]rification G > 0 : ", Simplify[G0sym > 0, rp > 0]];

(* Relation de Smarr (\[CapitalLambda]=0) : M = 2TS *)
SmarrCheck0 = Simplify[2 T0sym * S0sym - M0sym]
Print["V\[EAcute]rification Smarr (2TS - M) = ", SmarrCheck0, " \[Checkmark]"];


(* ::Subsection::Closed:: *)
(*Fonctions num\[EAcute]riques*)


TFlat[rp_] := 1.0 / (4.0 Pi rp);
MFlat[rp_] := rp / 2.0;
SFlat[rp_] := Pi rp^2;
CFlat[rp_] := -2.0 Pi rp^2;
GFlat[rp_] := rp / 4.0;


(* ::Subsection::Closed:: *)
(*Figures*)


g0a = Plot[TFlat[rp], {rp, 0.1, 15},
  GridLines -> Automatic,
  GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
  PlotStyle -> {colorF[1], Thick},
  FrameLabel -> {Style["r\!\(\*SubscriptBox[\(+\), \(\)]\)", 16],
                 Style["T", 16]},
  PlotLabel -> Style["Temp\[EAcute]rature de Hawking \[LongDash] Schwarzschild classique (\[CapitalLambda] = 0)", 13, Bold],
  PlotRange -> {{0, 15}, {0, 0.5}},
  PlotLegends -> Placed[
    LineLegend[{colorF[1]},
               {Style["T = 1/(4\[Pi]r\!\(\*SubscriptBox[\(+\), \(\)]\))", 12]}],
    {Right, Top}]
];
saveFig[g0a, "fig00a_T_rp_flat"];

g0b = Plot[MFlat[rp], {rp, 0.1, 15},
  GridLines -> Automatic,
  GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
  PlotStyle -> {colorF[2], Thick},
  FrameLabel -> {Style["r\!\(\*SubscriptBox[\(+\), \(\)]\)", 16], Style["M", 16]},
  PlotLabel -> Style["Masse ADM \[LongDash] Schwarzschild classique", 13, Bold],
  PlotLegends -> Placed[
    LineLegend[{colorF[2]}, {Style["M = r\!\(\*SubscriptBox[\(+\), \(\)]\)/2", 12]}],
    {Left, Top}]
];
saveFig[g0b, "fig00b_M_rp_flat"];

g0c = Plot[SFlat[rp], {rp, 0.1, 15},
  GridLines -> Automatic,
  GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
  PlotStyle -> {colorF[3], Thick},
  FrameLabel -> {Style["r\!\(\*SubscriptBox[\(+\), \(\)]\)", 16], Style["S", 16]},
  PlotLabel -> Style["Entropie de Bekenstein-Hawking \[LongDash] Schwarzschild classique", 13, Bold],
  PlotLegends -> Placed[
    LineLegend[{colorF[3]}, {Style["S = \[Pi]r\!\(\*SubsuperscriptBox[\(+\), \(\), \(2\)]\)", 12]}],
    {Left, Top}]
];
saveFig[g0c, "fig00c_S_rp_flat"];

g0d = Plot[CFlat[rp], {rp, 0.1, 15},
  GridLines -> Automatic,
  GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
  PlotStyle -> {colorF[4], Thick},
  FrameLabel -> {Style["r\!\(\*SubscriptBox[\(+\), \(\)]\)", 16], Style["C", 16]},
  PlotLabel -> Style["Capacit\[EAcute] calorique \[LongDash] Schwarzschild classique (C < 0 partout)", 13, Bold],
  PlotRange -> {{0, 15}, Automatic},
  Epilog -> {GrayLevel[0], Dashed, Line[{{0, 0}, {15, 0}}]},
  PlotLegends -> Placed[
    LineLegend[{colorF[4]}, {Style["C = -2\[Pi]r\!\(\*SubsuperscriptBox[\(+\), \(\), \(2\)]\)", 12]}],
    {Left, Bottom}]
];
saveFig[g0d, "fig00d_C_rp_flat"];

g0e = Plot[GFlat[rp], {rp, 0.1, 15},
  GridLines -> Automatic,
  GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
  PlotStyle -> {colorF[5], Thick},
  FrameLabel -> {Style["r\!\(\*SubscriptBox[\(+\), \(\)]\)", 16], Style["G", 16]},
  PlotLabel -> Style["Energie libre de Gibbs \[LongDash] Schwarzschild classique (\[CapitalLambda] = 0)", 13, Bold],
  PlotRange -> {{0, 15}, {0, 4}},
  Epilog -> {
    Inset[Style["G = r\!\(\*SubscriptBox[\(+\), \(\)]\)/4 > 0 partout\n\[DoubleRightArrow] Pas de transition de phase",
          11, Italic, GrayLevel[0.4]],
          {7, 1.75}, Background -> LightYellow]},
  PlotLegends -> Placed[
    LineLegend[{colorF[5]}, {Style["G = M - TS = r\!\(\*SubscriptBox[\(+\), \(\)]\)/4", 12]}],
    {Left, Top}]
];
saveFig[g0e, "fig00e_G_rp_flat"];

Print["  G = r+/4 > 0 partout. C < 0 partout."];


(* ::Section::Closed:: *)
(*Partie I : Schwarzschild-AdS*)


Print["\n", StringRepeat["=", 60]];
Print["PARTIE I : Schwarzschild-AdS"];
Print[StringRepeat["=", 60]];


(* ::Subsection::Closed:: *)
(*D\[EAcute]rivation symbolique*)


(* Metrique : f(r) = 1 - 2M/r + 8 Pi P r^2 / 3  (P = -\[CapitalLambda]/(8 Pi)) *)
fSchwAdS[r_, Mv_, Pv_] := 1 - 2 Mv/r + 8 Pi Pv r^2/3;

solM1 = Solve[fSchwAdS[rp, M, P] == 0, M][[1]];
M1sym = M /. solM1 // Simplify;
Print["Masse (Enthalpie) : M = ", M1sym];

fPrime1 = D[fSchwAdS[r, M, P], r] /. r -> rp /. solM1 // Simplify;
T1sym = fPrime1 / (4 Pi) // Simplify;
Print["Temp\[EAcute]rature : T = ", T1sym];

(* Minimum de T : dT/dr+ = 0  donne r_min = (8 Pi P)^{-1/2} *)
dT1dr = D[T1sym, rp];
solRmin = Solve[dT1dr == 0 && rp > 0, rp];
rpMin1 = rp /. solRmin[[1]] // Simplify // PowerExpand;
Print["Rayon minimal (PTN/GTN) : r_min = ", rpMin1];
Tmin1 = T1sym /. rp -> rpMin1 // Simplify // PowerExpand;
Print["Temp\[EAcute]rature minimale : T_min = ", Tmin1];

S1sym = Pi rp^2;

G1sym = M1sym - T1sym * S1sym // Expand // Simplify;
Print["Energie libre de Gibbs : G = ", G1sym];

(* Transition de Hawking-Page : G = 0 *)
solHP = Solve[G1sym == 0 && rp > 0, rp];
rpHP = rp /. solHP[[-1]] // Simplify // PowerExpand;
Print["Rayon de Hawking-Page : r_HP = ", rpHP];
THP = T1sym /. rp -> rpHP // Simplify // PowerExpand;
Print["Temp\[EAcute]rature de Hawking-Page : T_HP = ", THP];

dT1dr2 = D[T1sym, rp];
CP1sym = T1sym * (D[S1sym, rp] / dT1dr2) // Simplify;
Print["Capacit\[EAcute] calorique C_P = ", CP1sym];

(* Relation de Smarr etendue : M = 2TS - 2PV *)
V1sym = 4 Pi rp^3 / 3;
Smarr1 = Simplify[2 T1sym * S1sym - 2 P * V1sym - M1sym];
Print["V\[EAcute]rification Smarr (2TS - 2PV - M) = ", Smarr1, " \[Checkmark]"];


(* ::Subsection::Closed:: *)
(*Fonctions num\[EAcute]riques*)


TSchwAdS[rp_, Pv_] := 1.0/(4.0 Pi rp) + 2.0 Pv rp;
MSchwAdS[rp_, Pv_] := rp/2.0 + 4.0 Pi Pv rp^3/3.0;
SSchwAdS[rp_]      := Pi rp^2;
GSchwAdS[rp_, Pv_] := rp/4.0 - 2.0 Pi Pv rp^3/3.0;
CPSchwAdS[rp_, Pv_] := Module[{Tv, dTdr},
  Tv = TSchwAdS[rp, Pv];
  dTdr = -1.0/(4.0 Pi rp^2) + 2.0 Pv;
  If[Abs[dTdr] < 1*^-15, Missing[], Tv * 2.0 Pi rp / dTdr]
];

pressSchw = {0.0005, 0.001, 0.002, 0.004, 0.008};


(* ::Subsection::Closed:: *)
(*Inversion symbolique : r\[Congruent](T,P) et G(T) explicite*)


(* En multipliant T(r\[Congruent]) = 1/(4 \[Pi] r\[Congruent]) + 2 P r\[Congruent] par 4 \[Pi] r\[Congruent], on obtient *)
(* le polynome quadratique de contrainte en r\[Congruent] : *)
(*         8 \[Pi] P r\[Congruent]^2  -  4 \[Pi] T r\[Congruent]  +  1  =  0               *)
(* Les deux racines sont reelles pour T >= T_min = Sqrt(2 P / \[Pi]). *)

polyInvSAd[r_, Tv_, Pv_] := 8 Pi Pv r^2 - 4 Pi Tv r + 1;
polyInvSAdSym = polyInvSAd[rp, T, P];
solSAd = Solve[polyInvSAdSym == 0, rp];
Print["Polynome de contrainte (Schw-AdS) : ", polyInvSAdSym, " = 0"];
Print["Racines symboliques : rp = ", rp /. solSAd];

(* Branches explicites comme fonctions de T et P *)
TminSAd[Pv_] := Sqrt[2 Pv / Pi];

rSmallSAd[Tv_?NumericQ, Pv_?NumericQ] := 
  If[Tv^2 >= 2 Pv/Pi, (Tv - Sqrt[Tv^2 - 2 Pv/Pi]) / (4 Pv), Indeterminate];
rLargeSAd[Tv_?NumericQ, Pv_?NumericQ] := 
  If[Tv^2 >= 2 Pv/Pi, (Tv + Sqrt[Tv^2 - 2 Pv/Pi]) / (4 Pv), Indeterminate];

(* G(T) explicite par substitution sur chaque branche *)
GSmallSAd[Tv_?NumericQ, Pv_?NumericQ] := Module[{rv = rSmallSAd[Tv, Pv]},
  If[rv === Indeterminate, Indeterminate, rv/4 - 2 Pi Pv rv^3/3]
];
GLargeSAd[Tv_?NumericQ, Pv_?NumericQ] := Module[{rv = rLargeSAd[Tv, Pv]},
  If[rv === Indeterminate, Indeterminate, rv/4 - 2 Pi Pv rv^3/3]
];


(* ::Subsection::Closed:: *)
(*Figures*)


g1 = Plot[
  Evaluate[Table[TSchwAdS[rp, P], {P, pressSchw}]],
  {rp, 0.05, 12},
  GridLines -> Automatic,
  GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
  PlotStyle -> Table[{colorF[i], Thick}, {i, Length[pressSchw]}],
  FrameLabel -> {Style["r\!\(\*SubscriptBox[\(+\), \(\)]\)", 16], Style["T", 16]},
  PlotRange -> {{0, 12}, {0, 0.25}},
  PlotLabel -> Style["T(r\!\(\*SubscriptBox[\(+\), \(\)]\)) \[LongDash] Schwarzschild-AdS", 13, Bold],
  (* Minima marques : r_min = (8 Pi P)^{-1/2} *)
  Epilog -> Table[{colorF[i],
    PointSize[0.015],
    Point[{1/Sqrt[8 Pi pressSchw[[i]]], TSchwAdS[1/Sqrt[8 Pi pressSchw[[i]]], pressSchw[[i]]]}]},
    {i, Length[pressSchw]}],
  PlotLegends -> Placed[
    LineLegend[Table[colorF[i], {i, Length[pressSchw]}],
      Table[Style["P = " <> ToString[pressSchw[[i]]], 10], {i, Length[pressSchw]}]],
    {Left, Top}]
];
saveFig[g1, "fig01_T_rp_schw"];

(* Fig 2 : G(T) *)
rpMaxTrace[Pv_] := Max @ Select[
  rp /. NSolve[GSchwAdS[rp, Pv] == -3.0, rp, Reals],
  Positive
];
g2curvesA = Table[
  ParametricPlot[
    {TSchwAdS[rp, pressSchw[[i]]], GSchwAdS[rp, pressSchw[[i]]]},
    {rp, 0.05, rpMaxTrace[pressSchw[[i]]]},
    PlotStyle -> {colorF[i], Thick},
    PlotPoints -> 400, MaxRecursion -> 6, Exclusions -> None,
    WorkingPrecision -> MachinePrecision, Axes -> False],
  {i, Length[pressSchw]}
];

g2 = Legended[
  Show[Flatten[g2curvesA],
    Frame -> True,
    FrameLabel -> {Style["T", 16], Style["G", 16]},
    PlotRange -> {{0, 0.25}, {-2, 2}},
    AspectRatio -> 0.75,
    ImageSize -> 500,
    PlotLabel -> Style["G(T) \[LongDash] Transition de Hawking-Page (trace direct)", 13, Bold],
    Axes -> False,
    Epilog -> Flatten[{
      {GrayLevel[0], Dashed, Line[{{0, 0}, {0.25, 0}}]},
      Table[{colorF[i], PointSize[0.015],
        Point[{TSchwAdS[Sqrt[3.0/(8.0 Pi pressSchw[[i]])], pressSchw[[i]]], 0.0}]},
        {i, Length[pressSchw]}]}],
    GridLines -> Automatic,
    GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
    Background -> White
  ],
  Placed[
    LineLegend[Table[Directive[colorF[i], Thick], {i, Length[pressSchw]}],
      Table[Style["P = " <> ToString[pressSchw[[i]]], 10], {i, Length[pressSchw]}]],
    {Right, Top}]
];
saveFig[g2, "fig02_G_T_schw"];

(* Echelle symlog *)
symF[y_] := Sign[y] * Log10[1.0 + Abs[y]];
symData[curves_] := Map[{#[[1]], symF[#[[2]]]} &, curves, {2}];
symRescaleY[gr_] := gr /. {
   Line[pts_] :> Line[Map[{#[[1]], symF[#[[2]]]} &, pts]],
   Point[pts_List /; MatrixQ[pts]] :> Point[Map[{#[[1]], symF[#[[2]]]} &, pts]]
};
symDecades = {-100000., -10000., -1000., -100., -10., 0., 10., 100., 1000., 10000., 100000.};
symYTicks = Table[
   {symF[v],
    Which[
      v == 0., "0",
      v == 10., "10",
      v == -10., "-10",
      v > 0., Superscript[10, Round[Log10[v]]],
      True, Row[{"-", Superscript[10, Round[Log10[-v]]]}]
    ]},
   {v, symDecades}
];
symYTicksR = Map[{#[[1]], ""} &, symYTicks];   
symYRange  = {symF[-100000.], symF[100000.]}; 
symYGrid   = Map[symF, symDecades];

(* Fig 3 : CP diverge a r_div = (8 Pi P)^{-1/2} => bi-branche + exclusion symetrique *)
grCP1a = {};
grCP1b = {};
Do[
  rdiv = 1.0/Sqrt[8.0 Pi pressSchw[[i]]];
  eps  = 0.003;     
  epsA = 0.0003;   
  gl = Plot[CPSchwAdS[rp, pressSchw[[i]]], {rp, 0.1, rdiv - epsA},
    PlotStyle -> {colorF[i], Thick}, PlotRange -> All,
    PlotPoints -> 300, MaxRecursion -> 8, Exclusions -> None,
    WorkingPrecision -> MachinePrecision];
  gr2 = Plot[CPSchwAdS[rp, pressSchw[[i]]], {rp, rdiv + epsA, 15},
    PlotStyle -> {colorF[i], Thick}, PlotRange -> All,
    PlotPoints -> 300, MaxRecursion -> 8, Exclusions -> None,
    WorkingPrecision -> MachinePrecision];
  AppendTo[grCP1a, gl]; AppendTo[grCP1a, gr2];
  glL = Plot[CPSchwAdS[rp, pressSchw[[i]]], {rp, 0.1, rdiv - eps},
    PlotStyle -> {colorF[i], Thick},
    PlotPoints -> 300, MaxRecursion -> 6, Exclusions -> None,
    WorkingPrecision -> MachinePrecision];
  grL = Plot[CPSchwAdS[rp, pressSchw[[i]]], {rp, rdiv + eps, 15},
    PlotStyle -> {colorF[i], Thick},
    PlotPoints -> 300, MaxRecursion -> 6, Exclusions -> None,
    WorkingPrecision -> MachinePrecision];
  AppendTo[grCP1b, glL]; AppendTo[grCP1b, grL],
  {i, Length[pressSchw]}
];

divLinesFig3 = Table[{
    Directive[colorF[i], Thin, Dotted, Opacity[0.5]],
    InfiniteLine[{1.0/Sqrt[8.0 Pi pressSchw[[i]]], 0}, {0, 1}]
  }, {i, Length[pressSchw]}];

legendCP1 = LineLegend[
  Table[Directive[colorF[i], Thick], {i, Length[pressSchw]}],
  Table[Style["P = " <> ToString[pressSchw[[i]]], 9], {i, Length[pressSchw]}],
  LegendMarkerSize -> {18, 3},
  LegendMargins -> 2,
  Spacings -> {0.3, 0.1}
];

panelA = Legended[
  Show[symRescaleY /@ grCP1a,
    Frame -> True,
    FrameLabel -> {Style["r\!\(\*SubscriptBox[\(+\), \(\)]\)", 16], Style["C\!\(\*SubscriptBox[\(P\), \(\)]\)", 16]},
    PlotRange -> {{0, 15}, symYRange},
    FrameTicks -> {{symYTicks, symYTicksR}, {Automatic, None}},
    GridLines -> {Automatic, symYGrid},
    GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
    Background -> White,
    Epilog -> Flatten[{
      {GrayLevel[0], Dashed, Line[{{0, 0}, {15, 0}}]},
      divLinesFig3
    }, 1],
    PlotLabel -> Style["(a) Echelle symlog", 12, Bold],
    ImageSize -> 370
  ],
  Placed[legendCP1, {0.82, 0.22}]
];
panelB = Legended[
  Show[grCP1b,
    Frame -> True,
    FrameLabel -> {Style["r\!\(\*SubscriptBox[\(+\), \(\)]\)", 16], Style["C\!\(\*SubscriptBox[\(P\), \(\)]\)", 16]},
    PlotRange -> {{0, 15}, {-50, 50}},
    GridLines -> Automatic,
    GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
    Epilog -> Flatten[{
      {GrayLevel[0], Dashed, Line[{{0, 0}, {15, 0}}]},
      divLinesFig3,
      {Inset[Style["GTN (C\!\(\*SubscriptBox[\(P\), \(\)]\) > 0, hors plage)", Italic, 10, GrayLevel[0.5]], {10, 15}]},
      {Inset[Style["PTN (C\!\(\*SubscriptBox[\(P\), \(\)]\) < 0)", Italic, 10, GrayLevel[0.5]], {1.5, -25}]}
    }, 1],
    PlotLabel -> Style["(b) Zoom lin\[EAcute]aire", 12, Bold],
    ImageSize -> 370
  ],
  Placed[legendCP1, {0.82, 0.22}]
];
g3 = GraphicsGrid[{{panelA, panelB}},
  Spacings -> Scaled[0.03],
  ImageSize -> 760
];
saveFig[g3, "fig03_Cp_rp_schw"];
Print["  C_P diverge \[AGrave] r_div = (8\[Pi]P)^{-1/2}."];


(* ::Section::Closed:: *)
(*Partie II : Reissner-Nordstr\[ODoubleDot]m-AdS (Q = 1)*)


Print["\n", StringRepeat["=", 60]];
Print["PARTIE II : Reissner-Nordstr\[ODoubleDot]m-AdS (Q = 1)"];
Print[StringRepeat["=", 60]];


(* ::Subsection::Closed:: *)
(*D\[EAcute]rivation symbolique*)


(* Metrique : f(r) = 1 - 2M/r + Q^2/r^2 + 8 Pi P r^2 / 3 *)
fRN[r_, Mv_, Qv_, Pv_] := 1 - 2 Mv/r + Qv^2/r^2 + 8 Pi Pv r^2/3;

solM2 = Solve[fRN[rp, M, Q, P] == 0, M][[1]];
M2sym = M /. solM2 // Simplify
Print["Masse (Enthalpie) : M = ", M2sym];

fPrime2 = D[fRN[r, M, Q, P], r] /. r -> rp /. solM2 // Simplify;
T2sym = fPrime2 / (4 Pi) // Simplify
Print["Temp\[EAcute]rature : T = ", T2sym];

S2sym = Pi rp^2;

G2sym = M2sym - T2sym * S2sym // Expand // Simplify
Print["Energie libre de Gibbs : G = ", G2sym];

Phi2sym = Q / rp;
Print["Potentiel \[EAcute]lectrique : \[CapitalPhi] = ", Phi2sym];

(* Equation d'etat P(r+, T) puis P(v, T) avec v = 2 r+ *)
P2sym = Solve[T2sym == T, P][[1]];
Petat2 = P /. P2sym // Simplify
Print["Equation d'\[EAcute]tat P(r+, T) = ", Petat2];

Petat2v = Petat2 /. rp -> v/2 // Simplify
Print["Equation d'\[EAcute]tat P(v, T) = ", Petat2v];

(* Point critique : d2P/dv2 = 0 et dP/dv = 0 *)
dPdv   = D[Petat2v, v];
d2Pdv2 = D[Petat2v, {v, 2}];

Texpr = Assuming[Q > 0,
  T /. Solve[d2Pdv2 == 0, T][[1]] // Simplify
]

eqVc = dPdv /. T -> Texpr // Simplify;
solVc = Solve[eqVc == 0 && v > 0 && Q > 0, v];
vcSym = v /. solVc[[-1]] // Simplify // PowerExpand
rcSym = vcSym / 2 // Simplify // PowerExpand
Print["Volume critique : v_c = ", vcSym];
Print["Rayon critique : r_c = ", rcSym];

TcSym = Assuming[Q > 0, Texpr /. v -> vcSym // Simplify // PowerExpand]
Print["Temp\[EAcute]rature critique : T_c = ", TcSym];

PcSym = Assuming[Q > 0,
  Petat2v /. {v -> vcSym, T -> TcSym} // Simplify // PowerExpand
]
Print["Pression critique : P_c = ", PcSym];

(* Rapport universel 3/8 de van der Waals *)
ratioSym = Assuming[Q > 0, PcSym * vcSym / TcSym // FullSimplify // PowerExpand]
Print["Rapport universel P_c v_c / T_c = ", ratioSym, "  (Egal 3/8 de van der Waals)"];

Print["\n--- Equation d'\[EAcute]tat r\[EAcute]duite (variables r\[EAcute]duites) ---"];
PreduceSym[\[Omega]_, \[Theta]_] := 8 \[Theta]/(3 \[Omega]) - 2/\[Omega]^2 + 1/(3 \[Omega]^4);
verCrit = PreduceSym[1, 1]
Print["V\[EAcute]rification au point critique (\[Omega]=1,\[Theta]=1) : p = ", verCrit, " \[Checkmark]"];

(* Exposants critiques (champ moyen) : verification des relations d'echelle *)
Print["\n--- Exposants critiques (champ moyen) ---"];
Print["\[Beta] = 1/2  (param\[EGrave]tre d'ordre \[CapitalDelta]\[Omega] ~ |t|^{1/2})"];
Print["\[Delta] = 3   (isotherme critique : |P-P_c| ~ |v-v_c|^3)"];
Print["\[Gamma] = 1   (compressibilit\[EAcute] : \[Kappa]_T ~ |t|^{-1})"];
Print["\[Alpha] = 0   (C_V = 0 pour les TN de Bekenstein-Hawking)"];
Print["Rushbrooke : \[Alpha] + 2\[Beta] + \[Gamma] = ", 0 + 2*(1/2) + 1, " = 2 \[Checkmark]"];
Print["Griffiths : \[Beta](\[Delta]-1) = ", (1/2)*(3-1), " = \[Gamma] = 1 \[Checkmark]"];

dT2dr  = D[T2sym, rp];
CP2sym = T2sym * (D[S2sym, rp] / dT2dr) // Simplify
Print["\n C_P = ", CP2sym];

(* Divergences de C_P (Q=1) : r_div = sqrt((1 +/- sqrt(1 - 96 Pi P)) / (16 Pi P)), valides si 96 Pi P < 1 *)
dT2drQ1 = dT2dr /. Q -> 1;
solDivX = Solve[(dT2drQ1 /. rp -> Sqrt[x]) == 0 && x > 0, x, Reals] // Simplify;
rdivSymExpr = Sqrt[x] /. solDivX // Simplify // PowerExpand
Print["Positions des divergences de C_P (Q=1) : ", rdivSymExpr];

(* Smarr etendue avec terme electrostatique *)
V2sym  = 4 Pi rp^3 / 3;
Smarr2 = Simplify[2 T2sym * S2sym - 2 P * V2sym + Phi2sym * Q - M2sym]
Print["\n V\[EAcute]rification Smarr (2TS - 2PV + \[CapitalPhi]Q - M) = ", Smarr2, " \[Checkmark]"];


(* ::Subsection::Closed:: *)
(*Valeurs num\[EAcute]riques du point critique (Q = 1)*)


Q0 = 1.0;
rcN  = Sqrt[6.0] * Q0;
PcN  = 1.0 / (96.0 Pi Q0^2);
TcN  = Sqrt[6.0] / (18.0 Pi Q0);
vcN  = 2.0 * rcN;

Print["\n--- Point critique (Q = 1) ---"];
Print["r_c = ", rcN];
Print["P_c = ", PcN];
Print["T_c = ", TcN];
Print["v_c = ", vcN];
Print["P_c v_c / T_c = ", PcN * vcN / TcN, "  (exact = 3/8 = ", 3/8, ")"];


(* ::Subsection::Closed:: *)
(*Fonctions num\[EAcute]riques RN-AdS*)


QQ = 1.0;

TRN[rp_, Pv_]  := 1/(4 Pi rp) - QQ^2/(4 Pi rp^3) + 2 Pv rp;
MRN[rp_, Pv_]  := rp/2 + QQ^2/(2 rp) + 4 Pi Pv rp^3/3;
SRN[rp_]       := Pi rp^2;
GRN[rp_, Pv_]  := MRN[rp, Pv] - TRN[rp, Pv] * SRN[rp];
PRN[rp_, Tv_]  := Tv/(2 rp) - 1/(8 Pi rp^2) + QQ^2/(8 Pi rp^4);
PhiRN[rp_]     := QQ/rp;
CPRN[rp_, Pv_] := Module[{Tv, dTdr},
  Tv = TRN[rp, Pv];
  dTdr = -1/(4 Pi rp^2) + 3 QQ^2/(4 Pi rp^4) + 2 Pv;
  If[Abs[dTdr] < 1*^-14, Missing[], Tv * 2 Pi rp / dTdr]
];

findCPdivs[Pv_] := Module[{disc, rm, rpl},
  disc = 1.0 - Pv/PcN;
  Which[
    disc < 0, {},
    Abs[disc] < 1*^-10, {Sqrt[1.0/(16 Pi Pv)]},
    True,
    Select[{Sqrt[(1 - Sqrt[disc])/(16 Pi Pv)],
            Sqrt[(1 + Sqrt[disc])/(16 Pi Pv)]},
           # > QQ &]
  ]
];


(* ::Subsection::Closed:: *)
(*Inversion symbolique : r\[Congruent](T,P,Q) et G(T), S(T) explicites*)


(* En multipliant T(r\[Congruent]) = 1/(4 \[Pi] r\[Congruent]) - Q^2/(4 \[Pi] r\[Congruent]^3) + 2 P r\[Congruent] *)
(* par 4 \[Pi] r\[Congruent]^3, on obtient le polynome quartique de contrainte :       *)
(*   8 \[Pi] P r\[Congruent]^4  -  4 \[Pi] T r\[Congruent]^3  +  r\[Congruent]^2  -  Q^2  =  0          *)
(* Pour P < P_c, ce polynome admet 3 racines reelles > Q dans la fenetre *)
(* [T_min, T_max] (correspondant aux 3 branches PTN / instable / GTN),  *)
(* et 1 seule racine > Q en dehors. *)

polyInvRN[r_, Tv_, Pv_, Qv_] := 8 Pi Pv r^4 - 4 Pi Tv r^3 + r^2 - Qv^2;
polyInvRNSym = polyInvRN[rp, T, P, Q];
solsRN = Solve[polyInvRNSym == 0, rp];
Print["Polynome de contrainte (RN-AdS) : ", polyInvRNSym, " = 0"];
Print["  \[DoubleRightArrow] 4 racines algebriques r\[Congruent](T,P,Q), traitees par Root/NSolve."];

(* Racines physiques : reelles et > Q (pudeur de l'horizon), classees par r\[Congruent] croissant *)
(* Convention : branche 1 = PTN (plus petit r\[Congruent]), branche 2 = instable, branche 3 = GTN *)
rPhysRN[Tv_?NumericQ, Pv_?NumericQ, Qv_?NumericQ] := Module[
  {allRoots, realRoots},
  allRoots = rp /. NSolve[polyInvRN[rp, Tv, Pv, Qv] == 0, rp];
  realRoots = Select[allRoots, Abs[Im[#]] < 1*^-9 && Re[#] > Qv &];
  Sort[Re[realRoots]]
];

(* G(T) exprime explicitement comme fonction directe de T sur la branche k  *)
(* Substitution algebrique de r\[Congruent] -> racine_k dans G(r\[Congruent]) = r\[Congruent]/4 + 3Q^2/(4 r\[Congruent]) - 2\[Pi] P r\[Congruent]^3/3 *)
GRNofT[k_Integer][Tv_?NumericQ, Pv_?NumericQ, Qv_?NumericQ] := Module[
  {roots = rPhysRN[Tv, Pv, Qv], rv},
  If[Length[roots] < k, Indeterminate,
    rv = roots[[k]];
    rv/4 + 3 Qv^2/(4 rv) - 2 Pi Pv rv^3/3
  ]
];

(* S(T) explicite sur la branche k : substitution dans S(r\[Congruent]) = \[Pi] r\[Congruent]^2 *)
SRNofT[k_Integer][Tv_?NumericQ, Pv_?NumericQ, Qv_?NumericQ] := Module[
  {roots = rPhysRN[Tv, Pv, Qv]},
  If[Length[roots] < k, Indeterminate, Pi roots[[k]]^2]
];

(* Utilitaires : bornes de la fenetre 3-branches *)
(* Pour P < P_c : T_max = T(r\[Congruent]_1) (max local de T), T_min = T(r\[Congruent]_2) (min local) *)
TmaxRN[Pv_] := Module[{divs = findCPdivs[Pv]},
  If[Length[divs] == 2, TRN[divs[[1]], Pv], Missing["MonotonicT"]]
];
TminRN[Pv_] := Module[{divs = findCPdivs[Pv]},
  If[Length[divs] == 2, TRN[divs[[2]], Pv], Missing["MonotonicT"]]
];


(* ::Subsection::Closed:: *)
(*Figures*)


