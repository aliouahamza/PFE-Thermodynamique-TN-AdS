(*Tableau r\[EAcute]capitulatif comparatif*)


Print["\n", StringRepeat["=", 60]];
Print["TABLEAU R\[CapitalEAcute]CAPITULATIF COMPARATIF"];
Print[StringRepeat["=", 60]];

tableau = Grid[{
  {Style["Propri\[EAcute]t\[EAcute]", Bold, 12],
   Style["Schwarzschild", Bold, 12],
   Style["Schw.-AdS", Bold, 12],
   Style["RN-AdS", Bold, 12]},

  {"T(r\!\(\*SubscriptBox[\(+\), \(\)]\))",
   "1/(4\[Pi]r\!\(\*SubscriptBox[\(+\), \(\)]\))",
   "1/(4\[Pi]r\!\(\*SubscriptBox[\(+\), \(\)]\)) + 2Pr\!\(\*SubscriptBox[\(+\), \(\)]\)",
   "1/(4\[Pi]r\!\(\*SubscriptBox[\(+\), \(\)]\)) - \!\(\*SuperscriptBox[\(Q\), \(2\)]\)/(4\[Pi]r\!\(\*SubsuperscriptBox[\(+\), \(\), \(3\)]\)) + 2Pr\!\(\*SubscriptBox[\(+\), \(\)]\)"},

  {"G(r\!\(\*SubscriptBox[\(+\), \(\)]\))",
   "r\!\(\*SubscriptBox[\(+\), \(\)]\)/4",
   "r\!\(\*SubscriptBox[\(+\), \(\)]\)/4 - 2\[Pi]Pr\!\(\*SubsuperscriptBox[\(+\), \(\), \(3\)]\)/3",
   "r\!\(\*SubscriptBox[\(+\), \(\)]\)/4 + 3\!\(\*SuperscriptBox[\(Q\), \(2\)]\)/(4r\!\(\*SubscriptBox[\(+\), \(\)]\)) - 2\[Pi]Pr\!\(\*SubsuperscriptBox[\(+\), \(\), \(3\)]\)/3"},

  {"Monotonie T", "\[DownArrow] (stricte)", "Min unique", "Min + Max (P < Pc)"},
  {"Signe C",     "< 0 partout", "< 0 (PTN), > 0 (GTN)", "3 branches"},
  {"Transition",  "Aucune", "Hawking-Page", "PTN/GTN (type vdW)"},
  {"Point critique", "Non", "Non", "Oui (PcVc/Tc = 3/8)"}
  },
  Frame -> All,
  Background -> {{LightBlue, None}, {{LightGray, White}}},
  Spacings -> {2, 1},
  Alignment -> Center
];

Print[tableau];
Print["\n", StringRepeat["=", 60]];
Print["TOUTES LES FIGURES EXPORT\[CapitalEAcute]ES dans : ", outDir];
Print[StringRepeat["=", 60]];



