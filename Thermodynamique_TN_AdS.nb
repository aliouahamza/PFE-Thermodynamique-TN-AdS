(* Fig 6 : G(T) queue d'hirondelle *)
pratiosG = {0.5, 0.7, 0.85, 1.0, 1.15};

(* Racines de T(r,P) = T0 *)
findBranches[Pv_, T0_] := Module[
  {rscan, fvals, roots},
  rscan = Range[QQ + 0.01, 25, 0.003];
  fvals = TRN[#, Pv] - T0 & /@ rscan;
  roots = {};
  Do[
   If[fvals[[j]] * fvals[[j+1]] < 0,
    AppendTo[roots,
     FindRoot[TRN[rp, Pv] - T0,
      {rp, rscan[[j]], rscan[[j+1]]}][[1,2]]]],
   {j, Length[rscan]-1}];
  Sort[roots]
];

(* Resolution directe du systeme {T(r1)=T(r2), G(r1)=G(r2)} a P fixe *)
findCrossingDirect[Pv_, r1guess_, r2guess_] := Module[
  {sol, r1c, r2c, Tco, Gco},
  sol = Quiet[Check[
    FindRoot[
     {TRN[r1, Pv] == TRN[r2, Pv], GRN[r1, Pv] == GRN[r2, Pv]},
     {{r1, r1guess}, {r2, r2guess}},
     MaxIterations -> 300, AccuracyGoal -> 10],
    $Failed]];
  If[sol === $Failed, Return[None]];
  r1c = r1 /. sol; r2c = r2 /. sol;
  If[!(NumericQ[r1c] && NumericQ[r2c]), Return[None]];
  If[r1c < QQ + 0.001 || r2c <= r1c + 0.01, Return[None]];
  Tco = TRN[r1c, Pv]; Gco = GRN[r1c, Pv];
  If[!(NumericQ[Tco] && NumericQ[Gco]), Return[None]];
  {Tco, Gco, r1c, r2c}
];

grListA = {}; grListB = {}; crossings = {};

(* Bornes globales de T pour Plot[...] direct *)
Tlo = 0.0005;  (* borne inferieure (r\[Congruent] -> Q+) *)
Thi = 0.08;    (* borne superieure (branche GTN etendue) *)

Do[
  Pv = pratiosG[[i]] * PcN;
  divs = findCPdivs[Pv];
  lbl = "P/P\!\(\*SubscriptBox[\(c\), \(\)]\) = " <> ToString[pratiosG[[i]]];
  If[pratiosG[[i]] == 1.0, lbl = lbl <> " (crit.)"];
  sty     = If[pratiosG[[i]] == 1.0,
               {colorF[i], Thick, Dashing[{0.02, 0.01}]},
               {colorF[i], Thick}];
  styInst = {colorF[i], Thin, Dashed, Opacity[0.6]};

  If[Length[divs] == 2,
   (* P < P_c : trois branches physiques, 3-root window [T_min, T_max] *)
   r1d = divs[[1]]; r2d = divs[[2]];
   TmaxV = TRN[r1d, Pv];   (* maximum local de T(r\[Congruent]) *)
   TminV = TRN[r2d, Pv];   (* minimum local de T(r\[Congruent]) *)
   epsT = 1.0*^-4;         (* buffer anti-degenerescence aux extrema *)

   (* Branche PTN (k=1) : T \[Element] [2P, T_max], racine = plus petit r\[Congruent] > Q *)
   gPTN  = Plot[GRNofT[1][T, Pv, QQ],
             {T, 2.0 Pv + epsT, TmaxV - epsT},
             PlotStyle -> sty, PlotPoints -> 120, Exclusions -> None,
             WorkingPrecision -> MachinePrecision];

   (* Branche instable (k=2) : T \[Element] [T_min, T_max], racine mediane *)
   gInst = Plot[GRNofT[2][T, Pv, QQ],
             {T, TminV + epsT, TmaxV - epsT},
             PlotStyle -> styInst, PlotPoints -> 120, Exclusions -> None,
             WorkingPrecision -> MachinePrecision];

   (* Branche GTN : deux morceaux a recoller *)
   (* partie basse (regime 3-racines, k=3) : T \[Element] [T_min, T_max] *)
   gGTNlow = Plot[GRNofT[3][T, Pv, QQ],
             {T, TminV + epsT, TmaxV - epsT},
             PlotStyle -> sty, PlotPoints -> 120, Exclusions -> None,
             WorkingPrecision -> MachinePrecision];
   (* partie haute (regime 1-racine, k=1 par unicite) : T > T_max *)
   gGTNhi  = Plot[GRNofT[1][T, Pv, QQ],
             {T, TmaxV + epsT, Thi},
             PlotStyle -> sty, PlotPoints -> 120, Exclusions -> None,
             WorkingPrecision -> MachinePrecision];
   gGTN = Show[gGTNlow, gGTNhi];

   AppendTo[grListA, gPTN]; AppendTo[grListA, gInst]; AppendTo[grListA, gGTN];
   AppendTo[grListB, gPTN]; AppendTo[grListB, gInst]; AppendTo[grListB, gGTN];

   If[pratiosG[[i]] < 1.0,
    crossDir = findCrossingDirect[Pv, 0.8 r1d, 1.2 r2d];
    If[crossDir =!= None,
     AppendTo[crossings,
      {crossDir[[1]], crossDir[[2]], crossDir[[3]], crossDir[[4]],
       colorF[i], pratiosG[[i]]}];
     Print[" P/Pc = ", pratiosG[[i]],
           " : T_coex = ", NumberForm[crossDir[[1]], {5,5}],
           ", r1 = ",      NumberForm[crossDir[[3]], {4,2}],
           ", r2 = ",      NumberForm[crossDir[[4]], {4,2}]]]],

   (* P >= P_c : T(r\[Congruent]) monotone, une seule racine physique (k=1) *)
   gAll = Plot[GRNofT[1][T, Pv, QQ],
            {T, 2.0 Pv + 1.0*^-4, Thi},
            PlotStyle -> sty, PlotPoints -> 150, Exclusions -> None,
            WorkingPrecision -> MachinePrecision];
   AppendTo[grListA, gAll]; AppendTo[grListB, gAll]
  ],
  {i, Length[pratiosG]}
];

Print[" Total croisements trouv\[EAcute]s : ", Length[crossings]];

(* Epilogue panneau zoom : marqueurs + annotations r1, r2 *)
epilZoom = {};
Do[
  cr = crossings[[k]];
  AppendTo[epilZoom, {Black,   AbsolutePointSize[4], Point[{cr[[1]], cr[[2]]}]}];
  AppendTo[epilZoom, {cr[[5]], AbsolutePointSize[3], Point[{cr[[1]], cr[[2]]}]}];
  (* Decalage adapte a chaque courbe pour eviter superposition *)
  {offx, offy} = Which[
    cr[[6]] <= 0.5, { 0.004,  0.035},
    cr[[6]] <= 0.7, {-0.003, -0.040},
    True,           { 0.005,  0.040}
  ];
  xBox = cr[[1]] + offx;
  yBox = cr[[2]] + offy;

  AppendTo[epilZoom,
   {cr[[5]], AbsoluteThickness[1.2], Arrowheads[0.008],
    Arrow[{{xBox, yBox}, {cr[[1]], cr[[2]]}}]}];

  AppendTo[epilZoom,
   Inset[
    Framed[
     Style[
      Row[{Subscript["r","1"], " = ", NumberForm[cr[[3]], {3,2}],
           ",  ",
           Subscript["r","2"], " = ", NumberForm[cr[[4]], {3,2}]}],
      8, Bold, cr[[5]]],
     Background    -> White,
     FrameStyle    -> Directive[cr[[5]], AbsoluteThickness[1.2]],
     RoundingRadius -> 4,
     FrameMargins  -> {{3,3},{1,1}}],
    {xBox, yBox}, {Center, Center}]],

  {k, Length[crossings]}
];

AppendTo[epilZoom,
 Inset[Style["PTN \[RightArrow] GTN", Italic, 10, GrayLevel[0.5]],
       {0.040, 0.77}]];

