    Inset[Framed[
      Column[{
        Style["V\[EAcute]rification num\[EAcute]rique :", Bold, 9, Black],
        Row[{Style["Aire\!\(\*SuperscriptBox[\(\),\(+\)]\) = ",9,Black],
             Style[ScientificForm[areaP,3],9,Black]}],
        Row[{Style["Aire\!\(\*SuperscriptBox[\(\),\(-\)]\) = ",9,Black],
             Style[ScientificForm[areaM,3],9,Black]}],
        Row[{Style["|\[CapitalDelta]A|/A\!\(\*SuperscriptBox[\(+\),\(\)]\) = ",9,Black],
             Style[ScientificForm[Abs[areaP-areaM]/areaP,2],9,Black]}]
      }, Alignment -> Left, Spacings -> 0.3],
      Background -> LightYellow, RoundingRadius -> 4,
      FrameMargins -> {{4,4},{3,3}}],
     Scaled[{0.97, 0.50}], {Right, Center}],
    legendInset
  }],
  Frame      -> True,
  FrameLabel -> {Style["v = 2r\!\(\*SubscriptBox[\(+\),\(\)]\)",16],
                 Style["P",16]},
  PlotRange  -> {{0.5,16},{0,0.006}},
  PlotLabel  -> Style["Construction de Maxwell \[LongDash] \
T/T\!\(\*SubscriptBox[\(c\),\(\)]\) = 0.9", 13, Bold],
  GridLines      -> Automatic,
  GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
  ImageSize      -> 520
];

