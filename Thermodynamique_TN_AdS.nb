(* Fig 9 : CP(r+) RN-AdS, jusqu'a 2 divergences selon P/Pc *)
pratiosCP = {0.5, 0.8, 1.0, 1.3};
grCP2a = {}; grCP2b = {};
divListFig9 = {};
eps9  = 0.003;     
eps9A = 0.0003;    

Do[
  Pv = pratiosCP[[i]] * PcN;
  divs = findCPdivs[Pv];
  AppendTo[divListFig9, {i, divs}];
  sty = If[pratiosCP[[i]] == 1.0,
           {colorF[i], Thick, Dashing[{0.02, 0.01}]},
           {colorF[i], Thick}];

  If[Length[divs] == 2,
    (* Trois branches : PTN, instable, GTN *)
    g1i = Plot[CPRN[rp, Pv], {rp, QQ + 0.01, divs[[1]] - eps9A},
      PlotStyle -> sty, PlotRange -> All,
      PlotPoints -> 300, MaxRecursion -> 8, Exclusions -> None,
      WorkingPrecision -> MachinePrecision];
    g2i = Plot[CPRN[rp, Pv], {rp, divs[[1]] + eps9A, divs[[2]] - eps9A},
      PlotStyle -> sty, PlotRange -> All,
      PlotPoints -> 300, MaxRecursion -> 8, Exclusions -> None,
      WorkingPrecision -> MachinePrecision];
    g3i = Plot[CPRN[rp, Pv], {rp, divs[[2]] + eps9A, 10},
      PlotStyle -> sty, PlotRange -> All,
      PlotPoints -> 300, MaxRecursion -> 8, Exclusions -> None,
      WorkingPrecision -> MachinePrecision];
    AppendTo[grCP2a, g1i]; AppendTo[grCP2a, g2i]; AppendTo[grCP2a, g3i];
    h1i = Plot[CPRN[rp, Pv], {rp, QQ + 0.01, divs[[1]] - eps9},
      PlotStyle -> sty, PlotPoints -> 300, MaxRecursion -> 6, Exclusions -> None,
      WorkingPrecision -> MachinePrecision];
    h2i = Plot[CPRN[rp, Pv], {rp, divs[[1]] + eps9, divs[[2]] - eps9},
      PlotStyle -> sty, PlotPoints -> 300, MaxRecursion -> 6, Exclusions -> None,
      WorkingPrecision -> MachinePrecision];
    h3i = Plot[CPRN[rp, Pv], {rp, divs[[2]] + eps9, 10},
      PlotStyle -> sty, PlotPoints -> 300, MaxRecursion -> 6, Exclusions -> None,
      WorkingPrecision -> MachinePrecision];
    AppendTo[grCP2b, h1i]; AppendTo[grCP2b, h2i]; AppendTo[grCP2b, h3i],

    If[Length[divs] == 1,
      (* Point critique : divergence unique de second ordre *)
      g1i = Plot[CPRN[rp, Pv], {rp, QQ + 0.01, divs[[1]] - eps9A},
        PlotStyle -> sty, PlotRange -> All,
        PlotPoints -> 300, MaxRecursion -> 8, Exclusions -> None,
        WorkingPrecision -> MachinePrecision];
      g2i = Plot[CPRN[rp, Pv], {rp, divs[[1]] + eps9A, 10},
        PlotStyle -> sty, PlotRange -> All,
        PlotPoints -> 300, MaxRecursion -> 8, Exclusions -> None,
        WorkingPrecision -> MachinePrecision];
      AppendTo[grCP2a, g1i]; AppendTo[grCP2a, g2i];
      h1i = Plot[CPRN[rp, Pv], {rp, QQ + 0.01, divs[[1]] - eps9},
        PlotStyle -> sty, PlotPoints -> 80, MaxRecursion -> 4];
      h2i = Plot[CPRN[rp, Pv], {rp, divs[[1]] + eps9, 10},
        PlotStyle -> sty, PlotPoints -> 80, MaxRecursion -> 4];
      AppendTo[grCP2b, h1i]; AppendTo[grCP2b, h2i],

      (* P > Pc : branche unique sans divergence *)
      gAll = Plot[CPRN[rp, Pv], {rp, QQ + 0.01, 10},
        PlotStyle -> sty, PlotRange -> All,
        PlotPoints -> 200, MaxRecursion -> 6];
      hAll = Plot[CPRN[rp, Pv], {rp, QQ + 0.01, 10},
        PlotStyle -> sty, PlotPoints -> 80, MaxRecursion -> 4];
      AppendTo[grCP2a, gAll]; AppendTo[grCP2b, hAll]]
  ],
  {i, Length[pratiosCP]}
];

divLinesFig9 = Flatten[
