saveFig[g6, "fig06_GT_swallowtail"];
Print[" G(T) - queue d'hirondelle : ", Length[crossings],
      " points de croisement trouv\[EAcute]s."];

(* Fig 7 : courbe de coexistence par continuation *)
Print["  Courbe de coexistence ..."];

findCoex[Pv_, r1g_, r2g_] := Module[
  {eqs, sol},
  eqs = {TRN[r1, Pv] - TRN[r2, Pv],
         GRN[r1, Pv] - GRN[r2, Pv]};
  sol = Quiet[FindRoot[eqs, {{r1, r1g}, {r2, r2g}},
              MaxIterations -> 200, AccuracyGoal -> 10]];
  If[sol === $Failed, None,
    {r1 /. sol, r2 /. sol}]
];

(* Methode de continuation : r1, r2 precedents servent de guess *)
Pfracs = Range[0.98, 0.04, -0.01];
coexData = {};
r1prev = 0.85 rcN; r2prev = 1.15 rcN;
Do[
  Pv = fr * PcN;
  res = findCoex[Pv, r1prev, r2prev];
  If[res =!= None && res[[1]] > QQ + 0.01 && res[[2]] > res[[1]] + 0.05
     && res[[1]] < rcN && res[[2]] > rcN,
    Tco = TRN[res[[1]], Pv];
    If[Tco > 0,
      AppendTo[coexData, {Tco, Pv, res[[1]], res[[2]]}];
      r1prev = res[[1]]; r2prev = res[[2]]]],
  {fr, Pfracs}
];
AppendTo[coexData, {TcN, PcN, rcN, rcN}];
coexData = Sort[coexData, #1[[1]] < #2[[1]] &];
(* Filtrage monotone pour eliminer doublons numeriques *)
filtData = {coexData[[1]]};
Do[
  If[coexData[[k,1]] > filtData[[-1,1]] && coexData[[k,2]] > filtData[[-1,2]],
     AppendTo[filtData, coexData[[k]]]],
  {k, 2, Length[coexData]}];
coexData = filtData;
Tcoex = coexData[[All, 1]];
Pcoex = coexData[[All, 2]];
Print["    ", Length[coexData]-1, " points + critique."];

g7 = Legended[
  ListLinePlot[Transpose[{Tcoex, Pcoex}],
    PlotStyle -> {colorF[1], Thick},
    FrameLabel -> {Style["T", 16], Style["P", 16]},
    PlotRange -> {{0.008, TcN * 1.1}, {0, PcN * 1.15}},
    PlotLabel -> Style["Courbe de coexistence PTN/GTN \[LongDash] Construction de Maxwell", 13, Bold],
    Epilog -> {
      Red, PointSize[0.02], Point[{TcN, PcN}],
      Inset[Style["Point critique (T\!\(\*SubscriptBox[\(c\), \(\)]\), P\!\(\*SubscriptBox[\(c\), \(\)]\))", 10, Red], {TcN - 0.006, PcN + 0.0002}],
      Inset[Style["PTN\n(petit trou noir)", Bold, 10, colorF[1]], {0.020, 0.0015}],
      Inset[Style["GTN\n(grand trou noir)", Bold, 10, colorF[2]], {0.040, 0.00035}]},
    Frame -> True,
    GridLines -> Automatic,
    GridLinesStyle -> Directive[GrayLevel[0.85], Dashed],
    ImageSize -> 500
  ],
  Placed[
    LineLegend[
      {Directive[colorF[1], Thick], Directive[Red, PointSize[0.02]]},
      {Style["Courbe de coexistence", 10],
       Style["Point critique (T\!\(\*SubscriptBox[\(c\), \(\)]\), P\!\(\*SubscriptBox[\(c\), \(\)]\))", 10]},
      LegendMarkerSize -> {18, 3},
      LegendMargins -> 2,
      Spacings -> {0.3, 0.1}
    ],
    {0.22, 0.85}]
];
saveFig[g7, "fig07_coexistence"];

(* Fig 8 : Construction de Maxwell a T/Tc = 0.9 *)
Tmw = 0.9 * TcN;
vArr = Range[1.0, 16, 0.003];
Piso = PRN[#/2, Tmw] & /@ vArr;

(* Systeme Maxwell : P(r1) = P(r2) et aire nette = 0 *)
mwEqs[r1_, r2_] := Module[{P1, P2, vInt, Pint, area},
  P1 = PRN[r1, Tmw]; P2 = PRN[r2, Tmw];
  vInt = Range[2 r1, 2 r2, (2 r2 - 2 r1)/2000.0];
  Pint = PRN[#/2, Tmw] & /@ vInt;
  area = Total[(Pint - P1) * (vInt[[2]] - vInt[[1]])];
  {P1 - P2, area}
];

idxN = First[Ordering[Abs[Tcoex - Tmw]]];
r1g0 = coexData[[idxN, 3]]; r2g0 = coexData[[idxN, 4]];
solMW = Quiet[FindRoot[mwEqs[r1, r2],
  {{r1, r1g0}, {r2, r2g0}}, MaxIterations -> 500, AccuracyGoal -> 8]];
r1mw = r1 /. solMW; r2mw = r2 /. solMW;
Pmw  = PRN[r1mw, Tmw];
v1mw = 2 r1mw; v2mw = 2 r2mw;

vFill = Range[v1mw, v2mw, (v2mw - v1mw)/5000.0];
Pfill = PRN[#/2, Tmw] & /@ vFill;
dv = vFill[[2]] - vFill[[1]];
(* Verification : aire+ = aire- (egalite des aires de Maxwell) *)
areaP = Total[Max[#, 0] & /@ (Pfill - Pmw)] * dv;
areaM = Total[Max[#, 0] & /@ (Pmw - Pfill)] * dv;
Print["  Maxwell T/Tc=0.9 : r1 = ", NumberForm[r1mw, {6,4}],
      ", r2 = ", NumberForm[r2mw, {6,4}],
      ", P = ", ScientificForm[Pmw, 4]];
Print["    Aire+ = ", ScientificForm[areaP, 4],
      ", Aire- = ", ScientificForm[areaM, 4],
      ", |\[CapitalDelta]A|/A+ = ", ScientificForm[Abs[areaP - areaM]/areaP, 2]];

fillPlus  = Select[Transpose[{vFill, Pfill}], #[[2]] >= Pmw &];
fillMinus = Select[Transpose[{vFill, Pfill}], #[[2]] < Pmw &];

legendInset = Inset[
  Framed[
    Column[{
      LineLegend[
        {Directive[colorF[1], Thick],
         Directive[Red, Thick, Dashed],
         Directive[Green, Opacity[0.6]],
         Directive[Red, Opacity[0.6]]},
        {Style["Isotherme T/T\!\(\*SubscriptBox[\(c\), \(\)]\) = 0.9", 9],
         Style[Row[{"P\!\(\*SubscriptBox[\(Maxwell\), \(\)]\) = ",
                    NumberForm[Pmw, {5,5}]}], 9],
         Style[Row[{"Aire + = ", ScientificForm[areaP, 3]}], 9],
         Style[Row[{"Aire \[Minus] = ", ScientificForm[areaM, 3]}], 9]},
        LegendMarkerSize -> {18, 3},
        LegendMargins    -> {{0,0},{0,0}},
        Spacings         -> {0.3, 0.1}
      ],
      PointLegend[
        {Directive[Black, AbsolutePointSize[9]]},
        {Style["Point critique (v\!\(\*SubscriptBox[\(c\), \(\)]\),\
 P\!\(\*SubscriptBox[\(c\), \(\)]\))", 9]},
        LegendMarkers    -> {Graphics[{Black, Disk[{0,0},1]},
                                      ImageSize -> 9]},
        LegendMarkerSize -> {9, 9},
        LegendMargins    -> {{0,0},{0,0}},
        Spacings         -> {0.3, 0.1}
      ]
    }, Spacings -> 0.15, Alignment -> Left],
    Background    -> White,
    FrameStyle    -> Directive[GrayLevel[0.7], AbsoluteThickness[0.8]],
    RoundingRadius -> 4,
    FrameMargins  -> {{5,5},{4,4}}
  ],
  Scaled[{0.97, 0.93}], {Right, Top}
];

g8 = Show[
  ListLinePlot[Transpose[{vArr, Piso}],
    PlotStyle -> {colorF[1], Thick},
