saveFig[fig72, "fig2_ombres_Sch"];

Print["Verification : alpha^2 + beta^2 = 27 M^2"];
Print["  M = 0.75 : R_s = Sqrt[27] * 0.75 = ", N[Sqrt[27] 0.75, 5]];


(* ::Section::Closed:: *)
(*4. Figure 3 \[LongDash] R_s(P) Schwarzschild-AdS : signature Hawking-Page*)


ellFix = 10.0;
rhMinPhys = ellFix/Sqrt[3];

(* Branche stable : r_h > ell/Sqrt[3] *)
rhRange  = Subdivide[rhMinPhys 1.001, 5 ellFix, 3000];
TstableData  = Table[
  {TSchAdS[rh, ellFix] ellFix, RsSchAdS[MSchAdS[rh, ellFix], ellFix]/ellFix},
  {rh, rhRange}];

(* Branche instable : r_h < ell/Sqrt[3] *)
rhSmall  = Subdivide[0.1 ellFix, rhMinPhys 0.999, 500];
TinstableData = Table[
  {TSchAdS[rh, ellFix] ellFix, RsSchAdS[MSchAdS[rh, ellFix], ellFix]/ellFix},
  {rh, rhSmall}];

THP    = 1/(Pi ellFix);
Tmin73 = Sqrt[3]/(2 Pi ellFix);
RsHP   = RsSchAdS[ellFix, ellFix]/ellFix;

Print["T_HP * ell  = ", N[THP ellFix, 6]];
Print["T_min * ell = ", N[Tmin73 ellFix, 6]];
Print["R_s/ell a HP = ", N[RsHP, 6], " (theorique 3 Sqrt[3/28] = ", 
      N[3 Sqrt[3/28], 6], ")"];

ellSym      = Style["\[ScriptL]", FontFamily -> "Times New Roman", Italic, 14, Black];
ellSymSm    = Style["\[ScriptL]", FontFamily -> "Times New Roman", Italic, 11, Black];

fig73a = ListLinePlot[
  {TstableData, TinstableData},
  PlotStyle -> {Directive[cF[1], Thickness[0.0035]],
                Directive[cF[2], Thickness[0.0025], Dashing[0.02]]},
  PlotRange -> {{0.20, 1.0}, {0.0, 1.1}}, 
  FrameLabel -> {Row[{mIt["T", 14], " ", ellSym}], 
                 Row[{RsLab[14], " / ", ellSym}]},
  PlotLabel  -> Row[{mTx["(a) ", 12], RsLab[12], 
                     "(", mIt["T", 12],")" mTx[" Schwarzschild-AdS, ", 12], 
                     ellSymSm, mTx[" = 10", 12]}],
  Epilog -> {
    GrayLevel[0.5], Dashing[0.005], Thickness[0.0010],
    Line[{{THP ellFix, 0.0}, {THP ellFix, 1.1}}],
    Line[{{Tmin73 ellFix, 0.0}, {Tmin73 ellFix, 1.1}}],
    cF[3], PointSize[0.025], Point[{THP ellFix, RsHP}],
    Black, 
    Text[Style[THPLab[11], Background -> White], {THP ellFix + 0.035, 1.02}],
    Text[Style[TminLab[11], Background -> White], {Tmin73 ellFix - 0.030, 1.02}]},
  PlotLegends -> Placed[
    LineLegend[
      {Directive[cF[1], Thickness[0.0035]], 
       Directive[cF[2], Thickness[0.0025], Dashing[0.02]]},
      {mTx["Grande TN (stable)", 11], mTx["Petite TN (instable)", 11]}
    ],
    {0.65, 0.60}], 
  ImagePadding -> {{55, 15}, {45, 15}},
  GridLines -> None, ImageSize -> 500];

ellVar = Subdivide[0.5, 30.0, 800];
PvarData = Table[
  {3/(8 Pi ellv^2), RsSchAdS[1.0, ellv]},
  {ellv, ellVar}];

fig73b = ListLinePlot[PvarData,
  PlotStyle -> Directive[cF[1], Thickness[0.0035]],
  PlotRange -> {{0, 0.2}, {0, 6}},
  FrameLabel -> {mIt["P", 14], Row[{RsLab[14], " / ", mIt["M", 14]}]},
  PlotLabel  -> Row[{mTx["(b) ", 12], RsLab[12], 
                     "(", mIt["P", 12],")" mTx[" Schwarzschild-AdS, ", 12], 
                     mIt["M", 12], mTx[" = 1", 12]}],
  Epilog -> {
    cF[2], Dashing[0.015], Thickness[0.0025],
    Line[{{0, Sqrt[27]}, {0.2, Sqrt[27]}}]}, 
  PlotLegends -> Placed[
    LineLegend[
      {Directive[cF[1], Thickness[0.0035]], 
       Directive[cF[2], Dashing[0.015], Thickness[0.0025]]},
      {mTx["Schwarzschild-AdS", 11], 
       Row[{mTx["Limite plate : ", 11], RsLab[11], mTx[" \[Rule] \[Sqrt]27 ", 11], mIt["M", 11]}]}
    ],
    {0.65, 0.60}],
  ImagePadding -> {{55, 15}, {45, 15}},
  GridLines -> None, ImageSize -> 500];

fig73 = GraphicsRow[{fig73a, fig73b}, ImageSize -> 1150, Spacings -> 40];
saveFig[fig73, "fig3_Rs_HP_SchAdS"];


(* ::Section::Closed:: *)
(*5. Figure 4 \[LongDash] T(R_s) RN-AdS \[LongDash] signature VdW PTN/GTN*)


QV74 = 1.0;
TcRN74 = Sqrt[6]/(18 Pi QV74);
PcRN74 = 1/(96 Pi QV74^2);
rcRN74 = Sqrt[6] QV74;
TRN74[rh_, Pv_] := (1/(4 Pi rh))*
  (1 - QV74^2/rh^2 + 8 Pi Pv rh^2);
MRN74[rh_, Pv_] := (rh/2)*
  (1 + QV74^2/rh^2 + (8 Pi Pv/3) rh^2);
rpsRN74[rh_, Pv_] := With[
  {Mv = MRN74[rh, Pv]},
  (3 Mv + Sqrt[9 Mv^2 - 8 QV74^2])/2
];
RsRN74[rh_, Pv_] := With[
  {rps = rpsRN74[rh, Pv]},
  rps/Sqrt[fRNAdS[rps, MRN74[rh, Pv], QV74, Pv]]
];

(* Rayon de l'horizon extr\[EAcute]mal : T_H = 0 *)
rhExtrem74[Pv_] := Module[
  {aP = 8 Pi Pv, bP = 1, cP = -QV74^2},
  Sqrt[(-bP + Sqrt[bP^2 - 4 aP cP])/(2 aP)]
];

(* Courbe param\[EAcute]trique T(R_s) : R_s en abscisse, T en ordonn\[EAcute]e *)
makeBranch74[Pr_, n_: 4000] := Module[
  {Pv, rhLo, rhArr, pts},
  Pv = Pr PcRN74;
  rhLo = rhExtrem74[Pv] 1.0005;
  rhArr = Subdivide[rhLo, Max[12.0, 4 rcRN74], n];
  pts = Table[
    With[
      {
        Tv = TRN74[rh, Pv],
        Rsv = RsRN74[rh, Pv]
      },
      If[
        NumericQ[Tv] && NumericQ[Rsv] && Tv > 0 && Rsv > 0,
        {Rsv, Tv},
        Nothing
      ]
    ],
    {rh, rhArr}
  ];

  DeleteCases[pts, Nothing]
];
branchSub74 = makeBranch74[0.6];
branchCrit74 = makeBranch74[1.0];
branchSup74 = makeBranch74[1.5];

(* Construction de Maxwell dans le plan thermodynamique conjugu\[EAcute] (T,S) *)
maxwellRN74[Pr_] := Module[
  {
    Pv, rhLo, rhMaxLoc, rhMinLoc, TmaxLoc, TminLoc,
    TCoex, integFn, rhTest, Ttest, dT, scChanges, eps
  },

  Pv = Pr PcRN74;
  rhLo = rhExtrem74[Pv] 1.0005;

  rhTest = Subdivide[rhLo, 10.0, 5000];
  Ttest = TRN74[#, Pv] & /@ rhTest;
  dT = Differences[Ttest];

  scChanges =
    Flatten[Position[Differences[Sign[dT]], _?(# != 0 &)]];

  If[Length[scChanges] < 2, Return[$Failed]];

  rhMaxLoc = rhTest[[scChanges[[1]] + 1]];
  rhMinLoc = rhTest[[scChanges[[2]] + 1]];

  TmaxLoc = TRN74[rhMaxLoc, Pv];
  TminLoc = TRN74[rhMinLoc, Pv];

  integFn[TC_?NumericQ] := Module[
    {rA, rB, rC},
    rA = rh /. Quiet@FindRoot[
      TRN74[rh, Pv] == TC,
      {rh, (rhLo + rhMaxLoc)/2, rhLo, rhMaxLoc}
    ];
    rB = rh /. Quiet@FindRoot[
      TRN74[rh, Pv] == TC,
      {rh, (rhMaxLoc + rhMinLoc)/2, rhMaxLoc, rhMinLoc}
    ];
    rC = rh /. Quiet@FindRoot[
      TRN74[rh, Pv] == TC,
      {
        rh,
        (rhMinLoc + Max[12.0, 4 rcRN74])/2,
        rhMinLoc,
        Max[12.0, 4 rcRN74]
      }
    ];
    Quiet@NIntegrate[
      (TRN74[rh, Pv] - TC) 2 Pi rh,
      {rh, rA, rB, rC},
      Method -> "LocalAdaptive",
      AccuracyGoal -> 8,
      PrecisionGoal -> 4,
      MaxRecursion -> 20
    ]
  ];

  eps = (TmaxLoc - TminLoc) 0.01;

  Quiet@Check[
    TCoex = TC /. FindRoot[
      integFn[TC] == 0,
      {
        TC,
        (TmaxLoc + TminLoc)/2,
        TminLoc + eps,
        TmaxLoc - eps
      }
    ],
    Return[$Failed]
  ];

  {TCoex, rhMaxLoc, rhMinLoc}
];

maxwell74 = maxwellRN74[0.6];

If[
  maxwell74 =!= $Failed,

  {TCoex74, rhMaxLoc74, rhMinLoc74} = maxwell74;
  Pv06 = 0.6 PcRN74;

  rh1Mx = rh /. FindRoot[
    TRN74[rh, Pv06] == TCoex74,
    {
      rh,
      rhExtrem74[Pv06] 1.001,
      rhExtrem74[Pv06] 1.001,
      rhMaxLoc74
    }
  ];

  rh3Mx = rh /. FindRoot[
    TRN74[rh, Pv06] == TCoex74,
    {
      rh,
      (rhMinLoc74 + Max[12.0, 4 rcRN74])/2,
      rhMinLoc74,
      Max[12.0, 4 rcRN74]
    }
  ];

  RsPTN74 = RsRN74[rh1Mx, Pv06];
  RsGTN74 = RsRN74[rh3Mx, Pv06];

  Print["Maxwell P_r = 0.6 :"];
  Print[
    "  T_coex   = ", N[TCoex74, 6],
    " (= ", N[TCoex74/TcRN74, 5], " T_c)"
  ];
  Print[
    "  r_h(PTN) = ", N[rh1Mx, 5],
    " ; R_s(PTN) = ", N[RsPTN74, 5]
  ];
  Print[
    "  r_h(GTN) = ", N[rh3Mx, 5],
    " ; R_s(GTN) = ", N[RsGTN74, 5]
  ];
  Print["  Delta R_s = ", N[RsGTN74 - RsPTN74, 5]],

  Print["La construction de Maxwell a \[EAcute]chou\[EAcute]."]
];

RsCRN74val = RsRN74[rcRN74, PcRN74];
Print["R_s critique = ", N[RsCRN74val, 6]];

DeltaSym = Style[
  "\[CapitalDelta]",
  FontFamily -> "Times New Roman",
  Italic,
  12,
  Black
];

fig74 = ListLinePlot[
  {
    branchSub74,
    branchCrit74,
    branchSup74
  },
  PlotStyle -> {
    Directive[cF[2], Thickness[0.0035]],
    Directive[RGBColor[0.5, 0.31, 0.14], Thickness[0.0035]],
    Directive[cF[1], Thickness[0.0035]]
  },
  PlotRange -> {
    {3.5, 11.0},
    {0.005, 0.065}
  },
  FrameLabel -> {
    RsLab[14],
    mIt["T", 14]
  },
  PlotLabel -> Row[
    {
      mTx["Diagramme ", 13],
      mIt["T", 13],
      mTx[" - ", 13],
      RsLab[13],
      mTx[" pour RN-AdS (", 13],
      mIt["Q", 13],
      mTx[" = 1) \[AGrave] pressions fixes", 13]
    }
  ],

  PlotLegends -> Placed[
    {
      Row[
        {
          mIt["P", 11],
          " = 0.6 ",
          PcLab[11],
          mTx[" (sous-critique)", 11]
        }
      ],
      Row[
        {
          mIt["P", 11],
          " = ",
          PcLab[11],
          mTx[" (critique)", 11]
        }
      ],
      Row[
        {
          mIt["P", 11],
          " = 1.5 ",
          PcLab[11],
          mTx[" (supercritique)", 11]
        }
      ]
    },
    {0.80, 0.25}
  ],
  Epilog -> Join[
    {
      GrayLevel[0.5],
      Dashing[0.01],
      Thickness[0.0008],

      (* Ligne horizontale T = T_c *)
      Line[
        {
          {3.5, TcRN74},
          {11.0, TcRN74}
        }
      ],
      Black,
      Text[
        Style[TcLab[11], Background -> White],
        {10.0, TcRN74 + 0.0015}
      ],
      Black,
      PointSize[0.015],
      Point[{RsCRN74val, TcRN74}]
    },

    If[
      maxwell74 =!= $Failed,
      {
        Black,
        Dashing[0.005],
        Thickness[0.0010],

        (* Palier horizontal de coexistence *)
        Line[
          {
            {RsPTN74, TCoex74},
            {RsGTN74, TCoex74}
          }
        ],
        cF[3],
        PointSize[0.015],
        Point[{RsPTN74, TCoex74}],
        Point[{RsGTN74, TCoex74}],
        Black,
        Text[
          Style[
            Subscript[mIt["T", 11], mTx["coex", 9]],
            Background -> White
          ],
          {
            (RsPTN74 + RsGTN74)/2,
            TCoex74 + 0.0012
          }
        ],
        Text[
          Style[mTx["PTN", 11], Background -> White],
          {RsPTN74, TCoex74 + 0.0028}
        ],
        Text[
          Style[mTx["GTN", 11], Background -> White],
          {RsGTN74, TCoex74 + 0.0028}
        ],

        (* Saut horizontal Delta R_s *)
        Thickness[0.0015],
        Arrowheads[{-0.013, 0.013}],
        Arrow[
          {
            {RsPTN74 + 0.15, TCoex74 - 0.0040},
            {RsGTN74 - 0.15, TCoex74 - 0.0040}
          }
        ],
