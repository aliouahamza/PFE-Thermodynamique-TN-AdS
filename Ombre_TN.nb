];
saveFig[fig74, "fig4_Rs_T_RNAdS"];


(* ::Section::Closed:: *)
(*6. V\[EAcute]rification num\[EAcute]rique de l'exposant critique \[Beta] = 1/2 (plan optique)*)


(* Balayage isobarique sous-critique : pour chaque isobare, le saut                  *)
(* Delta R_s = R_s^GTN - R_s^PTN a la coexistence de Maxwell est reporte en fonction  *)
(* de |t| = 1 - T_coex/T_c. La pente log-log proche-critique confirme                 *)
(* Delta R_s ~ |t|^{1/2} (champ moyen, beta = 1/2).                                   *)

PrBeta74 = Join[Subdivide[0.45, 0.90, 15], Subdivide[0.91, 0.992, 11]];
rhFar74  = Max[12.0, 4 rcRN74];

betaData74 = DeleteCases[
  Table[
    Module[{mw = maxwellRN74[Pr], Pv, Tco, rh1, rh3, dRs, tAbs},
      If[mw === $Failed, Nothing,
        Pv  = Pr PcRN74;
        Tco = mw[[1]];
        rh1 = rh /. Quiet @ FindRoot[TRN74[rh, Pv] == Tco,
                {rh, rhExtrem74[Pv] 1.001, rhExtrem74[Pv] 1.001, mw[[2]]}];
        rh3 = rh /. Quiet @ FindRoot[TRN74[rh, Pv] == Tco,
                {rh, (mw[[3]] + rhFar74)/2, mw[[3]], rhFar74}];
        dRs  = RsRN74[rh3, Pv] - RsRN74[rh1, Pv];
        tAbs = 1 - Tco/TcRN74;
        If[NumericQ[dRs] && NumericQ[tAbs] && tAbs > 0 && dRs > 0,
           {tAbs, dRs}, Nothing]
      ]
    ],
    {Pr, PrBeta74}
  ],
  Nothing];

(* Ajustement log-log restreint a la fenetre proche-critique |t| <= tCut74 *)
tCut74     = 0.03;
betaNear74 = Select[betaData74, #[[1]] <= tCut74 &];
logFit74   = LinearModelFit[({Log[#[[1]]], Log[#[[2]]]} &) /@ betaNear74, x, x];
betaNum74  = logFit74["BestFitParameters"][[2]];
aFit74     = logFit74["BestFitParameters"][[1]];
Print["  beta numerique (pente log-log, |t| <= ", tCut74, ") = ",
      NumberForm[betaNum74, {4, 3}], "  (theorique 1/2)"];

(* Figure 4b : Delta R_s vs |t| en echelle log-log *)
tMinB74   = Min[betaData74[[All, 1]]];
tMaxB74   = Max[betaData74[[All, 1]]];
anchorB74 = First @ SortBy[betaData74, First];
C12n74    = anchorB74[[2]]/Sqrt[anchorB74[[1]]];
legBox = Framed[
  Grid[{
    {Graphics[{EdgeForm[Black], FaceForm[cF[2]], Disk[]}, ImageSize -> 11], 
     Style["points proche-critiques (|t| \[LessEqual] 0.03)", 12, FontFamily -> "Times New Roman"]},
    {Graphics[{EdgeForm[Directive[Thick, cF[2]]], FaceForm[White], Disk[]}, ImageSize -> 11], 
     Style["points hors r\[EAcute]gime asymptotique", 12, FontFamily -> "Times New Roman"]},
    {Graphics[{Black, Thickness[0.15], Line[{{0, 0}, {1, 0}}]}, ImageSize -> {25, 12}], 
     Style[Row[{"ajustement proche-critique : pente = ", NumberForm[betaNum74, {4, 3}]}], 12, FontFamily -> "Times New Roman"]},
    {Graphics[{RGBColor[0.5, 0.31, 0.14], Dashing[{0.15, 0.1}], Thickness[0.15], Line[{{0, 0}, {1, 0}}]}, ImageSize -> {25, 12}], 
     Style["pente 1/2 (champ moyen)", 12, FontFamily -> "Times New Roman"]}
   }, Alignment -> Left, Spacings -> {0.8, 0.5}],
  RoundingRadius -> 3, FrameStyle -> GrayLevel[0.4], Background -> White, ContentPadding -> True
];

resBox = Framed[
  Style[Row[{Subscript[Style["\[Beta]", Italic], "num"], " \[TildeEqual] ", 
             NumberForm[betaNum74, {3, 2}], "  \[RightArrow]  ", 
             Subscript[Style["\[Beta]", Italic], "theo"], " = 1/2"}], 
        14, FontFamily -> "Times New Roman"],
  RoundingRadius -> 3, FrameStyle -> GrayLevel[0.5], Background -> RGBColor[0.98, 0.98, 0.92], ContentPadding -> True
];

fig4b = Show[
  ListLogLogPlot[
    {Select[betaData74, #[[1]] <= tCut74 &],
     Select[betaData74, #[[1]] >  tCut74 &]},
    PlotMarkers -> {
      {Graphics[{EdgeForm[Black], FaceForm[cF[2]], Disk[]}], 0.04},
      {Graphics[{EdgeForm[Directive[Thick, cF[2]]], FaceForm[White], Disk[]}], 0.04}
    }
  ],
  LogLogPlot[
    {Exp[aFit74] t^betaNum74, C12n74 Sqrt[t]},
    {t, 0.8 tMinB74, 1.1 tMaxB74},
    PlotStyle -> {
      Directive[Black, Thickness[0.004]],
      Directive[RGBColor[0.5, 0.31, 0.14], Dashing[{0.02, 0.015}], Thickness[0.004]]
    }
  ],
  Frame -> True,
  FrameLabel -> {
    Style[Row[{"|", Style["t", Italic], "| = 1 \[Minus] ", Subscript[Overscript[Style["T", Italic], "~"], "coex"]}], 16, FontFamily -> "Times New Roman"],
    Style[Row[{"\[CapitalDelta]", Subscript[Style["R", Italic], "s"], " = ", Subsuperscript[Style["R", Italic], "s", "GTN"], " \[Minus] ", Subsuperscript[Style["R", Italic], "s", "PTN"]}], 16, FontFamily -> "Times New Roman"]
  },
  PlotLabel -> Style[Row[{"Confirmation num\[EAcute]rique de ", Style["\[Beta]", Italic], " = 1/2 : \[CapitalDelta]", Subscript[Style["R", Italic], "s"], " \[Proportional] ", Superscript[Row[{"|", Style["t", Italic], "|"}], "1/2"], " (RN-AdS, ", Style["Q", Italic], " = 1)"}], 15, FontFamily -> "Times New Roman"],
  PlotLegends -> None,
  Epilog -> {
    Inset[legBox, Scaled[{0.02, 0.98}], {Left, Top}],
    Inset[resBox, Scaled[{0.98, 0.05}], {Right, Bottom}]
  },
  GridLines -> None, 
  ImageSize -> 640,
  BaseStyle -> {FontFamily -> "Times New Roman", FontSize -> 14}
];
saveFig[fig4b, "fig4b_beta_loglog"];


(* ::Section::Closed:: *)
(*7. Figure 5 \[LongDash] Diagramme P-T avec R_s en color-map*)


(* Pour chaque point (T,P), on localise toutes les racines de T(r_h)=T par balayage de signe,
   puis on retourne la moyenne de R_s sur les branches coexistantes.
   La borne rhHi est dynamique pour capturer les trous noirs supermassifs a bas P. *)
RsOfTP75[Tv_?NumericQ, Pv_?NumericQ] := Module[
  {rhLo, rhHi, rhTest, Ttest, residual, roots, RsCandidates},
  rhLo   = rhExtrem74[Pv]*1.0005;
  rhHi   = Max[15.0, Tv / (1.5 * Pv) + 5.0]; 
  rhTest = Subdivide[rhLo, rhHi, 250];
  Ttest  = TRN74[#, Pv] & /@ rhTest;
  residual = Ttest - Tv;
  roots  = {};
  
  Do[
    If[residual[[k]]*residual[[k + 1]] < 0,
      AppendTo[roots,
        rh /. Quiet @ FindRoot[
          TRN74[rh, Pv] == Tv,
          {rh, (rhTest[[k]] + rhTest[[k + 1]])/2, rhTest[[k]], rhTest[[k + 1]]}]]],
    {k, 1, Length[rhTest] - 1}
  ];
  
  If[Length[roots] == 0, Return[Indeterminate]];
  RsCandidates = RsRN74[#, Pv] & /@ roots;
  Mean[RsCandidates]
];

TgridN = 100;
PgridN = 100;
Tgrid75 = Subdivide[0.005, 0.080, TgridN];
Pgrid75 = Subdivide[0.0005, 0.006, PgridN];

Print["Calcul R_s sur grille ", TgridN, "x", PgridN, " (veuillez patienter ~30s)..."];

RsMesh75 = Quiet @ Table[
  RsOfTP75[Tgrid75[[i]], Pgrid75[[j]]],
  {j, Length[Pgrid75]}, {i, Length[Tgrid75]}];

Print["Calcul courbe de coexistence PTN/GTN..."];

PrArr75 = Subdivide[0.015, 0.98, 45]; 
coexPts75 = DeleteCases[
  Quiet @ Table[
    Module[{res = maxwellRN74[Pr]},
      If[res === $Failed, Nothing, {res[[1]], Pr*PcRN74}]],
    {Pr, PrArr75}],
  Nothing];

fig75 = Show[
  ListContourPlot[
    Flatten[
      Table[
        {Tgrid75[[i]], Pgrid75[[j]],
         If[NumericQ[RsMesh75[[j, i]]], RsMesh75[[j, i]], Missing[]]},
        {j, Length[Pgrid75]}, {i, Length[Tgrid75]}],
      1],
    Contours           -> 60,
    ContourLines       -> False,
    InterpolationOrder -> 1,
    ColorFunction      -> ColorData["TemperatureMap"],
    Method             -> {"TransparentPolygonMesh" -> True},
    PlotLegends        -> BarLegend[Automatic, 
                            LegendLabel -> RsLab[13],
                            LegendMarkerSize -> 500,
                            LabelStyle -> Directive[FontFamily -> "Times New Roman", 12]],
    Frame              -> True,
    FrameLabel         -> {
      Row[{mTx["Temp\[EAcute]rature ", 14], mIt["T", 14]}],
      Row[{mTx["Pression ", 14], mIt["P", 14]}]}
  ],
  ListLinePlot[coexPts75, PlotStyle -> Directive[Black, Thickness[0.004]]],
  Graphics[{
    EdgeForm[Directive[Black, Thickness[0.0010]]], FaceForm[Red],
    Disk[{TcRN74, PcRN74}, Scaled[{0.010, 0.010}]],
    Black,
    Text[Style[Row[{"(", TcLab[11], ", ", PcLab[11], ")"}], Black], 
         {TcRN74 + 0.002, PcRN74 + 0.0002}],
    Text[Style[mTx["Coexistence", 11], White], 
         {0.030, 0.0012}, {0, 0}, {1, 1.8}],
    Text[Style[mTx["Phase PTN", 14], White], 
         {0.017, 0.0027}],
    Text[Style[mTx["Phase GTN", 14], Black], 
         {0.055, 0.0015}],
    Text[Style[mTx["Phase supercritique", 14], White], 
         {0.050, 0.0048}]
  }],
  PlotRange -> {{0.005, 0.080}, {0.0005, 0.006}},
  PlotRangeClipping -> True,
  PlotLabel ->
    Row[{mTx["Diagramme (", 13], mIt["P", 13], ",", mIt["T", 13], 
         mTx[") RN-AdS (", 13], mIt["Q", 13], mTx[" = 1) avec carte de ", 13], 
         RsLab[13]}],
  ImageSize -> 750
];

saveFig[fig75, "fig5_PT_Rs_colormap"];


(* ::Section::Closed:: *)
(*8. Figure 6 \[LongDash] Taux d emission energetique d^2E/(dw dt) en D=4*)


(* Section efficace d'absorption dans l'approximation geometrique : sigma_lim = pi R_s^2 *)
emissionRate[omega_, TH_, Rsv_] := 
  2 Pi^2 (Pi Rsv^2) omega^3 / (Exp[omega/TH] - 1);

omegaArr = Subdivide[0.005, 0.5, 1000];

(* Cas (a) : Schwarzschild plat, M=1 *)
casA76 = {1/(8 Pi M0), Sqrt[27] M0};
(* Cas (b) : Schwarzschild-AdS, r_h=2, ell=10 *)
TbVal76 = TSchAdS[2.0, 10.0]; MbVal76 = MSchAdS[2.0, 10.0];
casB76  = {TbVal76, RsSchAdS[MbVal76, 10.0]};
(* Cas (c) : RN-AdS, r_h=2, Q=0.5, P=0.5 P_c *)
QV76    = 0.5; PcQ05 = 1/(96 Pi QV76^2);
Pb76    = 0.5 PcQ05;
TcVal76 = (1/(4 Pi 2.0))(1 - QV76^2/2.0^2 + 8 Pi Pb76 2.0^2);
McVal76 = (2.0/2)(1 + QV76^2/2.0^2 + (8 Pi Pb76/3) 2.0^2);
casC76  = {TcVal76, (3 McVal76 + Sqrt[9 McVal76^2 - 8 QV76^2])/2 / 
                     Sqrt[1 - 2 McVal76/((3 McVal76 + Sqrt[9 McVal76^2 - 8 QV76^2])/2) + 
                          QV76^2/((3 McVal76 + Sqrt[9 McVal76^2 - 8 QV76^2])/2)^2 + 
                          (8 Pi Pb76/3) ((3 McVal76 + Sqrt[9 McVal76^2 - 8 QV76^2])/2)^2]};

data76 = Table[
  Table[{om, emissionRate[om, params[[1]], params[[2]]]}, 
        {om, 0.005, 0.5, 0.002}],
  {params, {casA76, casB76, casC76}}];

xLab76 = Row[{mTx["Fr\[EAcute]quence ", 14], Style["\[Omega]", FontFamily -> "Times New Roman", Italic, 14, Black]}];
yLab76 = Row[{Superscript[mIt["d", 14], mTx["2", 11]], " ", mIt["E", 14], " / (", mIt["d", 14], 
              Style["\[Omega]", FontFamily -> "Times New Roman", Italic, 14, Black], " ", mIt["d", 14], mIt["t", 14], ")"}];

titleLab76 = Column[{
   Row[{mTx["Taux d'\[EAcute]mission (D=4), ", 13], 
         Subscript[Style["\[Sigma]", Italic, 13, FontFamily -> "Times New Roman"], mTx["lim", 10]], 
         mTx[" = \[Pi] ", 13], Superscript[RsLab[13], mTx["2", 10]]}],
   Style[mTx["(Spectre local dans l'approximation de corps noir)", 11], Italic]}, Center];

legSchPlat = Row[{mTx["Schwarzschild plat (", 11], mIt["M", 11], mTx[" = 1)", 11]}];
legSchAdS  = Row[{mTx["Schwarzschild-AdS (", 11], rpLab[11], mTx[" = 2, ", 11], 
                  Style["\[ScriptL]", Italic, 11, FontFamily -> "Times New Roman"], mTx[" = 10)", 11]}];
legRNAdS   = Row[{mTx["RN-AdS (", 11], rpLab[11], mTx[" = 2, ", 11], 
                  mIt["Q", 11], mTx[" = 0.5, ", 11], 
                  mIt["P", 11], mTx[" = 0.5 ", 11], PcLab[11], ")"}];

fig76 = ListLinePlot[data76,
  PlotStyle -> {Directive[cF[1], Thickness[0.0035]],
                Directive[cF[2], Thickness[0.0035]],
                Directive[cF[3], Thickness[0.0035]]},
  PlotRange -> {{0, 0.5}, {0, 0.32}},
  FrameLabel -> {xLab76, yLab76},
  PlotLabel  -> titleLab76,
  PlotLegends -> Placed[{legSchPlat, legSchAdS, legRNAdS}, {0.80, 0.88}],
  GridLines -> None, ImageSize -> 720];

saveFig[fig76, "fig6_emission_rate"];


